            hero_cta1: "Voir les Démos", hero_cta2: "Pack Candidature",
            logos_label: "Organisations de confiance",
            about_label: "Qui je suis", about_title: "À propos",
            about_p1: "Ingénieur ML Junior & Spécialiste en Gouvernance IA. Je conçois des architectures IA pour la transition énergétique, strictement alignées sur les cadres <strong class='text-white'>ISO 42001</strong> et <strong class='text-white'>CIPP/E</strong> frameworks.",
            about_p2: "Je conseille les gouvernements sur la souveraineté des données. Mon approche est « frugale » : livrer du ML de qualité industrielle adapté aux contextes à faibles ressources.",
            trust_role_label: "Rôle actuel", trust_role: "Conseiller Gouvernance IA", trust_role_org: "CAIDP Afrique",
            trust_fellow_label: "Bourse majeure", trust_fellow: "Boursier ANITI", trust_fellow_year: "2023 — Présent",
            endorse_label: "Ce que disent les leaders",
            projects_label: "Recherche & Ingénierie", projects_title: "Projets Phares",
            projects_sub: "Open-source, déployés, avec notes de politique jointes.",
            demos_label: "Interactif & Déployé", demos_title: "Démos en Direct",
            demos_sub: "Applications prêtes pour la production que vous pouvez tester maintenant.",
            speaker_label: "Keynotes & Ateliers", speaker_title: "Conférences",
            speaker_topics: "Sujets de Keynote disponibles",
            packs_label: "Sur mesure pour les recruteurs", packs_title: "Packs Candidature",
            packs_sub: "Cliquez sur un type de poste pour télécharger un brief sur mesure.",
            media_label: "Réflexion stratégique", media_title: "Publications & Médias",
            media_featured: "Article phare", media_paper_title: "Souveraineté des données à l'ère du Climate AI",
            media_read: "Lire l'article", media_download: "PDF ↓", media_talks: "Conférences & Podcasts récents",
            teaching_label: "Transfer de connaissances", teaching_title: "Enseignement & Mentorat",
            teaching_sub: "Partager le savoir pour construire la prochaine génération d'ingénieurs responsables en Afrique.",
            contact_label: "Contact", contact_title: "Construisons l'avenir de l'IA.",
            contact_sub: "Ouvert aux postes IA Senior, Bourses et Keynotes.",
            form_name: "Nom", form_type: "Type de demande", form_subject: "Sujet", form_message: "Message", form_send: "Envoyer le message",
            newsletter_title: "Newsletter", newsletter_sub: "1-2 emails/mois : études de cas, conférences.",
            calendly_title: "Réservez un appel", calendly_sub: "15 ou 30 minutes. Sans intermédiaire.", calendly_btn: "Ouvrir Calendly",
            toast_subscribed: "Inscrit ! Vérifiez votre email.", toast_sent: "Message envoyé !",
            filter_all: "Tout", filter_eng: "Ingénierie", filter_policy: "Politique", filter_edu: "Éducation"
        }
    };
    let currentLang = 'en';
    function setLang(lang) {
        currentLang = lang;
        const toggle = document.getElementById('lang-toggle');
        if(toggle) toggle.textContent = lang === 'en' ? 'FR' : 'EN';
        document.documentElement.lang = lang;
        
        if (lang === 'fr') {
            document.querySelectorAll('[data-i18n]').forEach(el => {
                const key = el.getAttribute('data-i18n');
                if (translations.fr[key]) el.innerHTML = translations.fr[key];
            });
        } else {
            document.querySelectorAll('[data-i18n]').forEach(el => {
                if (el.dataset.original) el.innerHTML = el.dataset.original;
            });
        }
    }
    document.querySelectorAll('[data-i18n]').forEach(el => {
        el.dataset.original = el.innerHTML;
    });
    const langToggle = document.getElementById('lang-toggle');
    if(langToggle) {
        langToggle.addEventListener('click', () => {
            setLang(currentLang === 'en' ? 'fr' : 'en');
        });
    }

    // =============================================
    // TOAST SYSTEM
    // =============================================
    function showToast(message, type = 'success') {
        let container = document.getElementById('toast-container');
        if(!container) {
            container = document.createElement('div');
            container.id = 'toast-container';
            container.className = 'fixed bottom-6 right-6 z-[70] flex flex-col gap-2';
            document.body.appendChild(container);
        }
        const toast = document.createElement('div');
        const colors = type === 'success' ? 'border-cyan-500/50 bg-[#111]' : 'border-red-500/50 bg-[#111]';
        const icon = type === 'success' ? '✓' : '✕';
        const iconColor = type === 'success' ? 'text-cyan-400' : 'text-red-400';
        toast.className = `flex items-center gap-3 px-5 py-3.5 rounded-xl border ${colors} shadow-2xl transform translate-x-full transition-transform duration-500`;
        toast.innerHTML = `<span class="${iconColor} font-bold">${icon}</span><span class="text-white text-sm">${message}</span>`;
        container.appendChild(toast);
        requestAnimationFrame(() => { toast.style.transform = 'translateX(0)'; });
        setTimeout(() => {
            toast.style.transform = 'translateX(120%)';
            setTimeout(() => toast.remove(), 500);
        }, 3500);
    }

    // =============================================
    // SCROLL PROGRESS BAR
    // =============================================
    const progressBar = document.getElementById('scroll-progress');
    window.addEventListener('scroll', () => {
        const scrollTop = window.scrollY;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        if (progressBar) progressBar.style.width = `${(scrollTop / docHeight) * 100}%`;
    }, { passive: true });

    // =============================================
    // BACK TO TOP
    // =============================================
    const backToTop = document.getElementById('back-to-top');
    window.addEventListener('scroll', () => {
        if (backToTop) {
            if (window.scrollY > 600) {
                backToTop.style.opacity = '1';
                backToTop.style.transform = 'translateY(0)';
                backToTop.style.pointerEvents = 'auto';
            } else {
                backToTop.style.opacity = '0';
                backToTop.style.transform = 'translateY(1rem)';
                backToTop.style.pointerEvents = 'none';
            }
        }
    }, { passive: true });
    if(backToTop) {
        backToTop.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
    }

    // =============================================
    // SMOOTH SCROLL + CLOSE MOBILE
    // =============================================
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function(e) {
            e.preventDefault();
            const target = document.querySelector(this.getAttribute('href'));
            if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
            const mobileMenu = document.getElementById('mobile-menu');
            if(mobileMenu) mobileMenu.classList.add('hidden');
            const openIcon = document.getElementById('menu-icon-open');
            const closeIcon = document.getElementById('menu-icon-close');
            if(openIcon) openIcon.classList.remove('hidden');
            if(closeIcon) closeIcon.classList.add('hidden');
        });
    });

    // =============================================
    // MOBILE MENU
    // =============================================
    const menuBtn = document.getElementById('menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    if(menuBtn && mobileMenu) {
        menuBtn.addEventListener('click', () => {
            const isHidden = mobileMenu.classList.toggle('hidden');
            document.getElementById('menu-icon-open').classList.toggle('hidden', !isHidden);
            document.getElementById('menu-icon-close').classList.toggle('hidden', isHidden);
        });
    }

    // =============================================
    // PROJECT FILTERS
    // =============================================
    const filterBtns = document.querySelectorAll('.filter-btn');
    const projectCards = document.querySelectorAll('.project-card');
    filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            filterBtns.forEach(b => {
                b.classList.remove('bg-white/10', 'text-white', 'active');
                b.classList.add('text-gray-400');
            });
            btn.classList.add('bg-white/10', 'text-white', 'active');
            btn.classList.remove('text-gray-400');
            const filter = btn.dataset.filter;
            projectCards.forEach(card => {
                const match = filter === 'all' || card.dataset.category === filter;
                if (match) {
                    card.style.display = '';
                    requestAnimationFrame(() => {
                        card.style.opacity = '1';
                        card.style.transform = 'translateY(0)';
                    });
                } else {
                    card.style.opacity = '0';
                    card.style.transform = 'translateY(20px)';
                    setTimeout(() => card.style.display = 'none', 300);
                }
            });
        });
    });

    // =============================================
    // APPLICATION PACK TABS
    // =============================================
    document.querySelectorAll('.pack-tab').forEach(tab => {
        tab.addEventListener('click', () => {
            document.querySelectorAll('.pack-tab').forEach(t => {
                t.classList.remove('bg-white/10', 'text-white', 'active');
                t.classList.add('text-gray-400');
            });
            tab.classList.add('bg-white/10', 'text-white', 'active');
            tab.classList.remove('text-gray-400');
            document.querySelectorAll('.pack-content').forEach(c => c.classList.add('hidden'));
            const packContent = document.getElementById('pack-' + tab.dataset.pack);
            if(packContent) packContent.classList.remove('hidden');
        });
    });

    // =============================================
    // FORMS
    // =============================================
    const contactForm = document.getElementById('contact-form');
    if(contactForm) {
        contactForm.addEventListener('submit', (e) => {
            e.preventDefault();
            const msg = currentLang === 'fr' ? translations.fr.toast_sent : 'Message sent!';
            showToast(msg);
            e.target.reset();
        });
    }

    const newsletterForm = document.getElementById('newsletter-form');
    if(newsletterForm) {
        newsletterForm.addEventListener('submit', (e) => {
            e.preventDefault();
            const msg = currentLang === 'fr' ? translations.fr.toast_subscribed : 'Subscribed! Check your email.';
            showToast(msg);
            e.target.reset();
        });
    }

    // =============================================
    // SCROLL REVEAL ANIMATIONS
    // =============================================
    const revealElements = document.querySelectorAll('.reveal-up');
    const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                const delay = entry.target.style.transitionDelay || '0s';
                entry.target.style.opacity = '0';
                entry.target.style.transform = 'translateY(30px)';
                requestAnimationFrame(() => {
                    requestAnimationFrame(() => {
                        entry.target.style.transition = `opacity 0.8s ease-out ${delay}, transform 0.8s ease-out ${delay}`;
                        entry.target.style.opacity = '1';
                        entry.target.style.transform = 'translateY(0)';
                    });
                });
                revealObserver.unobserve(entry.target);
            }
        });
    }, { threshold: 0.1 });
    revealElements.forEach(el => {
        el.style.opacity = '0';
        revealObserver.observe(el);
    });

    // =============================================
    // PARTICLE CANVAS
    // =============================================
    const canvas = document.getElementById('particle-canvas');
    if (canvas) {
        const ctx = canvas.getContext('2d');
        let particles = [];
        let mouseX = -1000, mouseY = -1000;
        const PARTICLE_COUNT = 60;
        const CONNECTION_DIST = 120;
        const MOUSE_RADIUS = 150;
        
        function resizeCanvas() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }
        resizeCanvas();
        window.addEventListener('resize', resizeCanvas);
        window.addEventListener('mousemove', (e) => {
            mouseX = e.clientX;
            mouseY = e.clientY;
        }, { passive: true });
        
        class Particle {
            constructor() {
                this.x = Math.random() * canvas.width;
                this.y = Math.random() * canvas.height;
                this.vx = (Math.random() - 0.5) * 0.4;
                this.vy = (Math.random() - 0.5) * 0.4;
                this.size = Math.random() * 1.5 + 0.5;
            }
            update() {
                this.x += this.vx;
                this.y += this.vy;
                if (this.x < 0 || this.x > canvas.width) this.vx *= -1;
                if (this.y < 0 || this.y > canvas.height) this.vy *= -1;
                
                const dx = mouseX - this.x;
                const dy = mouseY - this.y;
                const dist = Math.sqrt(dx * dx + dy * dy);
                if (dist < MOUSE_RADIUS) {
                    this.x -= dx * 0.01;
                    this.y -= dy * 0.01;
                }
            }
            draw() {
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
                ctx.fillStyle = 'rgba(6, 182, 212, 0.4)';
                ctx.fill();
            }
        }
        for (let i = 0; i < PARTICLE_COUNT; i++) particles.push(new Particle());
        
        function animateParticles() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            particles.forEach(p => { p.update(); p.draw(); });
            
            for (let i = 0; i < particles.length; i++) {
                for (let j = i + 1; j < particles.length; j++) {
                    const dx = particles[i].x - particles[j].x;
                    const dy = particles[i].y - particles[j].y;
                    const dist = Math.sqrt(dx * dx + dy * dy);
                    if (dist < CONNECTION_DIST) {
                        ctx.beginPath();
                        ctx.moveTo(particles[i].x, particles[i].y);
                        ctx.lineTo(particles[j].x, particles[j].y);
                        ctx.strokeStyle = `rgba(6, 182, 212, ${0.08 * (1 - dist / CONNECTION_DIST)})`;
                        ctx.stroke();
                    }
                }
            }
            requestAnimationFrame(animateParticles);
        }
        animateParticles();
    }
    </script>
</body>
</html>