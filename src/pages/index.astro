                <a href="https://github.com/LionsClo" target="_blank" class="hover:text-cyan-400 transition-colors text-2xl">gh</a>
                <a href="https://x.com/AgreLionceau" target="_blank" class="hover:text-cyan-400 transition-colors text-2xl">X</a>
