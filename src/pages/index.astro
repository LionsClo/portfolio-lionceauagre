    </nav>

    <!-- SCROLL PROGRESS -->
    <div id="scroll-progress" class="fixed top-0 left-0 h-1 bg-gradient-to-r from-cyan-500 to-blue-600 z-[60] w-0 transition-all duration-100"></div>

    <main class="relative pt-20">
        <!-- HERO SECTION -->
        <section class="min-h-screen flex items-center justify-center relative overflow-hidden px-6">
            <!-- Particle Canvas -->
            <canvas id="particle-canvas" class="absolute inset-0 w-full h-full pointer-events-none z-0"></canvas>
            
            <div class="max-w-5xl mx-auto text-center relative z-10 reveal-up">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 mb-8">
                    <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
                    <span class="text-xs font-mono text-cyan-400 uppercase tracking-widest" data-i18n="hero_tag">AI Governance &middot; Climate Tech &middot; Data Sovereignty</span>
                </div>
                
                <h1 class="text-5xl md:text-7xl font-bold text-white tracking-tight mb-6 leading-tight">
                    Lionceau Clovis <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-500">AGRE</span>
