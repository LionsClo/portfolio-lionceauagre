    const translations = {
        fr: {
            nav_about: "À propos", nav_projects: "Projets", nav_demos: "Démos", nav_media: "Médias", nav_hire: "Recruter",
            hero_tag: "Gouvernance IA &middot; Climate Tech &middot; Souveraineté des données",
