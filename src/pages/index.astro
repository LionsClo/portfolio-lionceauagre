    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Lionceau Agre",
      "url": "https://lionceauagre.com",
      "jobTitle": "AI & Climate Governance Expert",
      "knowsAbout": ["Artificial Intelligence Governance", "Climate AI", "Data Policy in Africa", "ISO 42001", "Machine Learning"],
      "sameAs": [
        "https://www.linkedin.com/in/lionceau-clovis-agre-074a0b1b1/",
        "https://github.com/LionsClo",
        "https://x.com/AgreLionceau",
        "https://www.youtube.com/@lionceauclovisagre397"
      ]
    }
    </script>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="../styles/global.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&display=swap" rel="stylesheet">
    
    <title>Lionceau Agre | AI, Climate & Governance Expert</title>

    <script is:inline>
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                document.querySelector(this.getAttribute('href')).scrollIntoView({ behavior: 'smooth' });
            });
        });
