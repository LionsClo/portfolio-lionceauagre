                        <span class="text-[11px] font-mono font-bold text-gray-400 group-hover:text-cyan-400 transition-colors">ISO 42001</span>
                    </a>
                    <a href="#" class="group flex items-center gap-2 px-3 py-2 rounded-lg bg-white/5 border border-white/10 hover:border-purple-500/50 hover:bg-purple-500/5 transition-all cursor-pointer" title="CIPP/E Privacy Certificate">
